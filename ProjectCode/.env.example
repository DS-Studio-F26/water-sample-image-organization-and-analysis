# Copy this file to ProjectCode/.env and fill in the real values.
# .env is gitignored -- never commit it. Everything in it is secret.

# Supabase: "Connect" button > Connection string > Session pooler (URI form).
# Not the direct connection, which is IPv6-only and often fails on campus Wi-Fi.
# URL-encode special characters in the password (for example @ becomes %40).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>.pooler.supabase.com:5432/postgres

# Cloudflare account ID (shown on the R2 overview page); builds the R2 S3 endpoint.
R2_ACCOUNT_ID=<cloudflare-account-id>

# R2 API token (R2 > Manage API tokens) with Object Read & Write on the bucket.
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>

# The bucket that holds the images.
R2_BUCKET=water-sample-images
