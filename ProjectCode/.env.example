# Copy to ProjectCode/.env and fill in. .env is gitignored and secret -- never commit it.

# Supabase "Connect" > Session pooler URI (not the IPv6-only direct one); URL-encode the password.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>.pooler.supabase.com:5432/postgres

# Cloudflare account ID (shown on the R2 overview page); used to build the R2 endpoint URL.
R2_ACCOUNT_ID=<cloudflare-account-id>

# Access Key ID of an R2 API token (R2 > Manage API tokens) with Object Read & Write on the bucket.
R2_ACCESS_KEY_ID=<r2-access-key-id>

# Secret Access Key of that same R2 API token.
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>

# Name of the R2 bucket that holds the images.
R2_BUCKET=water-sample-images
