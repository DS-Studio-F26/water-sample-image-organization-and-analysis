# Raw image datasets — too large/numerous for git (hundreds of thousands of files, several GB)
ProjectCode/WCMC_raw_images_2023_and_others/
ProjectCode/catalog_output/folder_images/

# Cataloging script output: the raw manifest CSV is ~140MB (over GitHub's 100MB
# file limit) and regenerates from `python ProjectCode/catalog_images.py`, so it
# stays local. folder_summary.csv, qa_log.csv, and the gzip-compressed manifest
# (image_manifest.csv.gz, ~13MB) are small enough to commit and are NOT ignored.
ProjectCode/catalog_output/image_manifest.csv
# FlowCam measurements for every image (~140 MB even gzipped, over GitHub's
# limit). catalog_images.py rebuilds it from ProjectCode/vbd_export.
ProjectCode/catalog_output/image_measurements.csv.gz

# macOS
.DS_Store

# Plan A hosting: secrets (DB password, R2 keys) live in ProjectCode/.env --
# never commit it. ProjectCode/.env.example holds the placeholders.
.env
ProjectCode/.env

# Python bytecode
__pycache__/

# Cloudflare Worker: npm packages and wrangler's local dev state
node_modules/
.wrangler/

# Website build output (ProjectCode/build.mjs); Cloudflare Pages builds it itself
dist/

# FlowCam VBD exports (Flowcam_VBD_File_Format/export_all.py): one folder per run,
# regenerated from the VBD files, several GB -- like the image folder above.
ProjectCode/vbd_export/
# Measurement filter files (deploy/build_filter_data.py), uploaded to R2 _filters/
ProjectCode/catalog_output/filter_data/
